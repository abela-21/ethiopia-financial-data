# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ethiopia_economic_data
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=ethiopia_economic_data

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
SESSION_SECRET=your-session-secret-here

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# External API Keys (Optional)
WORLD_BANK_API_KEY=your-world-bank-api-key
UN_STATS_API_KEY=your-un-stats-api-key

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=True

# Application Settings
APP_NAME=Ethiopia Economic Data Platform
APP_VERSION=1.0.0
ITEMS_PER_PAGE=20
MAX_UPLOAD_SIZE=16777216

# Security Settings
BCRYPT_LOG_ROUNDS=12
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600

# Cache Settings
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=ethiopia_economic_

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=100 per hour